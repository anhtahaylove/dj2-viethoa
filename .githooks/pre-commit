#!/bin/sh
# Fast gates, run before every commit.
#
# The full suite takes ~7 minutes and needs the mod JARs from the launcher
# instance (%APPDATA%/ElyPrismLauncher), so it cannot run here or on CI.
# These gates need neither: they read files the repo already tracks and
# finish in seconds. They catch the mistakes that actually shipped:
# CRLF creep from write_text(), and README figures drifting from evidence.
#
# Install:  git config core.hooksPath .githooks
# Bypass :  git commit --no-verify   (for a deliberate work-in-progress)
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Prefer the interpreter the tools are developed against, fall back to PATH.
PY="$LOCALAPPDATA/Programs/Python/Python312/python.exe"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
[ -n "$PY" ] || { echo "pre-commit: no python found; skipping gates" >&2; exit 0; }

fail=0
for gate in check_line_endings check_readme_numbers check_readme_root_numbers; do
    if ! out="$("$PY" "tools/$gate.py" 2>&1)"; then
        printf "pre-commit: %s FAILED\n%s\n" "$gate" "$out" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "Commit blocked. Fix the gate above, or pass --no-verify to skip." >&2
    exit 1
fi
