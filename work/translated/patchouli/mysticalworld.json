{
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/blocks.json::name": "Khối",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/blocks.json::description": "Tại đây có danh mục nhiều khối tuyệt đẹp được tìm thấy trong thế giới bí ẩn này.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/creatures.json::name": "Sinh vật",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/creatures.json::description": "Nhiều sinh vật cư ngụ trong thế giới này; đây là danh sách của chúng.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/crops.json::name": "Cây trồng",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/crops.json::description": "Có những cây trồng bí ẩn đang chờ được khám phá!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/cuisine.json::name": "Ẩm thực",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/cuisine.json::description": "Có nhiều món ăn thơm ngon và huyền bí để chế biến và thưởng thức!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/features.json::name": "Đặc điểm",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/features.json::description": "Ngoài những địa điểm cụ thể, cảnh quan xung quanh bạn còn có nhiều đặc điểm được tạo ra tự nhiên. Hãy tìm kiếm chúng!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/items.json::name": "Vật phẩm",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/items.json::description": "Có nhiều vật phẩm huyền bí được tìm thấy trong thế giới kỳ bí này.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/locations.json::name": "Địa điểm",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/locations.json::description": "Có nhiều địa điểm để khám phá, một số đã đổ nát và bỏ hoang, còn số khác thì không hẳn là không có cư dân!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/ores.json::name": "Quặng",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/categories/ores.json::description": "Có thể tìm thấy nhiều loại quặng dưới lòng đất, một số trông khá bình thường, số khác lại mang vẻ bí ẩn hơn nhiều.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/charred_wood.json::name": "Charred Wood",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/charred_wood.json::pages/0/text": "Được tìm thấy trong thế giới tại những nơi gỗ đã cháy hoặc cây có lẽ đã bị sét đánh, những khúc gỗ này chủ yếu dùng để trang trí.$(br2)Có thể dùng flint and steel để đốt chúng cháy sém thêm; vật phẩm này sẽ mất độ bền (không bị tiêu hao) trong quá trình đó. Bạn cũng có thể dùng fire charge, nhưng nó sẽ bị tiêu hao.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/charred_wood.json::pages/2/text": "Có thể chế tạo các khúc gỗ thành ván theo cách thông thường.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/charred_wood.json::pages/3/text": "Có thể chế tạo ván thành nhiều loại khối trang trí.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::name": "Đồ trang trí từ Mud Block",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/0/text": "Có thể chế tạo cầu thang từ cả dried mud blocks lẫn dried mud bricks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/1/title": "Cầu thang",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/2/text": "Có thể chế tạo phiến từ cả dried mud blocks lẫn dried mud bricks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/3/title": "Slabs",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/4/text": "Có thể chế tạo Walls từ cả dried mud blocks và dried mud bricks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/5/title": "Walls",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/6/text": "Có thể chế tạo Fences từ cả dried mud blocks và dried mud bricks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/7/title": "Fences",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/8/text": "Có thể chế tạo Fence Gates từ cả dried mud blocks và dried mud bricks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_decoration.json::pages/9/title": "Fences",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_utility.json::name": "Công dụng của Mud Block",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_utility.json::pages/0/text": "Có thể chế tạo Pressure Plates từ cả mud blocks và mud bricks. Do làm từ đá, chúng chủ yếu phản ứng với sinh vật.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_utility.json::pages/1/title": "Pressure Plates",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_utility.json::pages/2/text": "Có thể chế tạo Buttons từ cả mud bricks và mud blocks.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_block_utility.json::pages/3/title": "Buttons",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::name": "Mud Blocks",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::pages/0/text": "Sau khi chế tạo, chúng có thể được sấy khô trong lò nung.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::pages/1/title": "Wet Mud Blocks",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::pages/1/text": "Wet Bricks cũng có thể được chế tạo.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::pages/2/title": "Chế tạo nhanh hơn",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/mud_blocks.json::pages/2/text": "Bạn có thể nung Mud Blocks và Mud Bricks trong lò để chuyển chúng thành .",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_decoration.json::name": "Vật trang trí bằng Pearl Block",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_decoration.json::pages/0/text": "Cần 9 viên Pearl để chế tạo Pearl Block, nhưng cũng có thể hoàn tác chế tạo.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_decoration.json::pages/1/title": "Stairs & Slabs",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_decoration.json::pages/2/title": "Walls & Fences",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_decoration.json::pages/3/title": "Fence Gates",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_utility.json::name": "Công dụng của Pearl Block",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/blocks/pearl_block_utility.json::pages/0/title": "Plates & Buttons",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/beetle.json::name": "Beetle",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/beetle.json::pages/1/name": "Beetle",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/beetle.json::pages/1/text": "Lại cúi người và nhấp chuột phải bằng tay không để đặt chúng xuống.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/clam.json::name": "Clam",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/clam.json::pages/1/name": "Clam",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/clam.json::pages/1/text": "Clam trưởng thành phát ra các hạt, và khi bị giết sẽ rơi ra một $(l:items/pearl)pearl$() (hoặc có thể là ender pearl nếu đó là Clam đặc biệt!)",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/deer.json::name": "Deer",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/deer.json::pages/1/name": "Deer",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/deer.json::pages/1/text": "Những Deer này là một đàn hiền lành gồm cả con cái lẫn con đực.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/endermini.json::name": "Endermini",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/endermini.json::pages/1/name": "Endermini",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/endermini.json::pages/1/text": "Những sinh vật này thường sống ở The End cùng với những người anh em lớn hơn của chúng, Endermen.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/fox.json::name": "Fox",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/fox.json::pages/1/name": "Fox",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/fox.json::pages/1/text": "Dù là những kẻ săn Chicken và Rabbit hung dữ, chúng sẽ trở nên hiền lành khi được thuần hóa!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/frog.json::name": "Frog",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/frog.json::pages/1/name": "Frog",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/frog.json::pages/1/text": "Khi nhảy nhót, những chú Frog này thỉnh thoảng để lại một vũng slime!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/hell_sprout.json::name": "Hell Sprout",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/hell_sprout.json::pages/1/name": "Hell Sprout",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/lava_cat.json::name": "Lava Cat",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/lava_cat.json::pages/1/name": "Lava Cat",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/lava_cat.json::pages/1/text": "Tương tự, việc đi vào lava sẽ biến chúng trở lại trạng thái ban đầu.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/owl.json::name": "Owl",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/owl.json::pages/1/name": "Owl",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/silkworm.json::name": "Silkworm",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/silkworm.json::pages/0/text": "Chúng sẽ lớn dần theo thời gian và tạo ra $(l:items/silk_cocoon)cocoons$().$(br2)Chúng không xuất hiện ở quần xã cụ thể nào và cũng không thể sinh sản, nhưng bạn có thể cho chúng nở từ trứng. Xem trang sau để biết nơi trứng rơi ra.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/silkworm.json::pages/1/name": "Silkworm",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/silkworm.json::pages/1/text": "Bạn có thể nhấp chuột phải để cho chúng ăn lá, giúp đẩy nhanh quá trình.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/silkworm.json::pages/2/text": "Cho Silkworm ăn lá sẽ tăng số lượng Silk Cocoon rơi ra và đẩy nhanh quá trình.$(br2)Silkworm không xuất hiện tự nhiên và cũng không thể sinh sản, nhưng có thể nở từ trứng (với một tỉ lệ thành công nhất định).$(br2)Bạn có thể tìm thấy trứng bằng cách phá lá, tương tự như khi tìm sapling.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/sprout.json::name": "Sprout",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/sprout.json::pages/1/name": "Sprout",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/sprout.json::pages/1/text": "Những củ Sprout đáng yêu này thích tản bộ trên bãi biển, lang thang trong rừng và đang cố học cách nhảy múa!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/squid.json::name": "Squid",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/squid.json::pages/1/name": "Squid",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/squid.json::pages/1/text": "Xúc tu Squid cũng rất ngon khi được nấu chín!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/crops/aubergine.json::name": "Aubergines",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/crops/aubergine.json::pages/0/text": "Có thể tìm thấy hạt giống Aubergine khắp thế giới, ở bất cứ nơi nào có cỏ để phá.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/crops/aubergine.json::pages/1/text": "Khi thu hoạch cây đã trưởng thành, Aubergine là một món ăn nhẹ thơm ngon và còn có thể dùng để chế biến nhiều món khác!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/crops/aubergine.json::pages/1/title": "Cây Aubergine",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::name": "Aubergine",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::pages/0/text": "Có thể thu hoạch Aubergine từ $(l:crops/aubergine)cây Aubergine trưởng thành$() và sử dụng theo nhiều cách.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::pages/1/title": "Cooked Aubergine",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::pages/1/text": "Sau khi nấu chín và loại bỏ hạt, có thể thêm các nguyên liệu khác vào Aubergine để món ăn càng ngon hơn!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::pages/2/title": "Stuffed Aubergine",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/aubergine.json::pages/2/text": "Một món chay tuyệt hảo, kết hợp Aubergine với Beetroot, Carrot và Potato để tạo nên một bữa ăn thực sự thịnh soạn!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/beetroot.json::name": "Cooked Beetroot",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/beetroot.json::pages/0/text": "Beetroot rất ngon khi được nướng!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/beetroot.json::pages/1/title": "Cooked Beetroot",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/beetroot.json::pages/1/text": "Beetroot có thể được nấu từ từ trong lò nung.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/carrot.json::name": "Công thức với Carrot",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/carrot.json::pages/0/text": "Giống như Beetroot, Carrot cũng có thể được nướng.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/carrot.json::pages/1/title": "Cooked Carrot",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/carrot.json::pages/1/text": "Carrot có thể được nấu từ từ trong lò nung.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/salads.json::name": "Salad",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/salads.json::pages/0/text": "Salad giúp lấp đầy cả bát lẫn bụng của bạn!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::name": "Squid",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::pages/0/text": "Bạn có thể lấy xúc tu Squid sống bằng cách giết $(l:creatures/squid)Squid$(). Có thể ăn sống, nhưng cũng có thể đem nấu chín.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::pages/1/title": "Calamari",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::pages/1/text": "Quá trình sơ chế xúc tu mực để nấu ăn tạo ra rất nhiều calamari, có thể kết hợp với các nguyên liệu khác để mang lại trải nghiệm còn tuyệt vời và bí ẩn hơn!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::pages/2/title": "Epic Squid",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/suqid.json::pages/2/text": "Không thể phủ nhận sự hấp dẫn màu tím của Epic Squid! Tuy nguyên liệu chế tạo khá đắt đỏ, món này sẽ lấp đầy gần như mọi cơn đói và đồng thời mang lại nhiều lợi ích đáng kể. Thật vậy, bạn có thể ăn nó bất cứ lúc nào chỉ để nhận những lợi ích ấy.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/toasted_seeds.json::name": "Toasted Seeds",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/toasted_seeds.json::pages/0/text": "Có thể kết hợp 4 hạt giống thuộc bất kỳ loại nào để tạo thành assorted seeds.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/toasted_seeds.json::pages/1/title": "Toasted Seeds",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/toasted_seeds.json::pages/1/text": "Một món ăn nhẹ đơn giản, chế biến nhanh, giúp tận dụng lượng hạt giống dư thừa và tiếp thêm năng lượng đúng lúc bạn cần!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/venison.json::name": "Venison",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/venison.json::pages/0/text": "Có thể lấy Venison từ $(l:creatures/deer)deer$() rồi nấu thành một bữa ăn thịnh soạn.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/venison.json::pages/1/title": "Cooked Venison",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/venison.json::pages/1/text": "Bạn cũng có thể lấy dạng thịt đã nấu chín từ deer bị giết khi đang cháy hoặc bằng sát thương lửa.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/features/burnt_trees.json::name": "Charred Tree",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/features/burnt_trees.json::pages/0/title": "Charred Tree",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/features/burnt_trees.json::pages/0/text": "Hầu hết gỗ thường cháy rụi hoàn toàn, nhất là khi bị sét đánh, nhưng một số loài cây cứng cáp vẫn gần như nguyên vẹn, ngoại trừ phần lá.$(br2)Bạn có thể bắt gặp tàn tích của những cây cháy sém này trên khắp thế giới.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/features/burnt_trees.json::pages/1/title": "Một cây cháy sém",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/features/burnt_trees.json::pages/1/text": "$(l:blocks/charred_wood)Khối Charred Wood$() có thể dùng để trang trí.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/antler_hat.json::name": "Antler Hat",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/antler_hat.json::pages/0/text": "Antler có thể dùng để chế tạo một chiếc mũ vừa bắt mắt vừa hữu ích!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/antler_hat.json::pages/1/text": "Khi đội, chiếc mũ này sẽ triệu hồi những con hươu ma để hồi máu cho bạn lúc nguy cấp.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/beetle_mask.json::name": "Beetle Mask",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/beetle_mask.json::pages/0/text": "Carapace có thể dùng để chế tạo một chiếc mặt nạ đáng sợ.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/beetle_mask.json::pages/1/text": "Khi đeo, chiếc mặt nạ này sẽ triệu hồi những con bọ ma hỗ trợ bạn chiến đấu.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/copper_armor.json::name": "Copper Armor",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/copper_armor.json::pages/0/text": "Copper tạo nên bộ giáp bền đáng ngạc nhiên, đồng thời tăng máu tối đa khi bạn mặc nó!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/gall_apple.json::name": "Gall Apple",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/gall_apple.json::pages/0/text": "Có thể thu hoạch Gall Apple từ những cây bị ấu trùng ong bắp cày ký sinh. Thông thường, bạn có thể bắt đầu quá trình này bằng cách dùng $(l:items/wasp_attractant)Wasp Attractant$() lên cây sồi hoặc sồi đen.$(br2)Những 'quả táo' này chứa nhiều $(l:items/tannins)Tannins$(), dùng để sản xuất da thuộc.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/pearleporter.json::name": "Pearleporter",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/pearleporter.json::pages/0/text": "Pearleporter là một thiết bị tài tình, cho phép bạn lấy $(l:items/pearls)Pearls$() từ $(l:creatures/clam)Clams$() mà không làm chúng bị thương!$(br2)Tuy nhiên, bạn sẽ cần một Pearl để bắt đầu.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silk_cocoon.json::name": "Silk Cocoon",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silk_cocoon.json::pages/0/text": "Những Silk Cocoon này được $(l:creatures/silkworm)Silkworms$() tạo ra sau một thời gian sinh trưởng. Có thể đẩy nhanh quá trình này bằng cách thả lá xuống đất gần đó để Silkworms ăn.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silk_thread.json::name": "Silk Thread",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silk_thread.json::pages/0/text": "Có thể thu được Silk Thread bằng cách xử lý $(l:items/silk_cocoons)Silkworm Cocoons$(), nhưng số lượng sẽ thay đổi tùy theo phương pháp.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silk_thread.json::pages/1/text": "Kết hợp Silkworm Cocoon với Spindle sẽ cho kết quả tốt nhất, nhưng sẽ tiêu hao một phần độ bền của Spindle.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silver_armor.json::name": "Silver Armor",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/silver_armor.json::pages/0/text": "Silver tạo nên bộ giáp sáng bóng tuyệt đẹp, vừa tăng sát thương tấn công vừa gây sát thương lên mọi Undead đánh trúng bạn!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/tannins.json::name": "Tannins & Leather Production",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/tannins.json::pages/0/text": "Một gall apple đủ để sản xuất bốn lọ tannins.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/tannins.json::pages/1/text": "Một lọ tannins đủ để thuộc ba miếng rotten flesh thành leather.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/unripe_pearl.json::name": "Unripe Pearls",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/unripe_pearl.json::pages/0/text": "Unripe pearls có thể được tìm thấy ở những Endermen non chưa trưởng thành, được gọi là Endermini.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/unripe_pearl.json::pages/1/text": "Khi sử dụng, vật phẩm này sẽ dịch chuyển bạn đến một vị trí ngẫu nhiên. Có thể ghép cùng 8 viên khác để tạo thành một ender pearl.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/unripe_pearl.json::pages/1/title": "Ender Pearl",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/wasp_attractant.json::name": "Wasp Attractant",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/wasp_attractant.json::pages/0/text": "Hỗn hợp protein và đường có tỷ lệ vừa đủ để thu hút ong bắp cày!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/items/wasp_attractant.json::pages/1/text": "Có thể bôi chất dẫn dụ lên hầu hết các loại oak tree (oak thường và dark oak). Ấu trùng được ong bắp cày tiêm vào sẽ nhanh chóng tạo ra một $(l:items/gall_apple)gall apple$().",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/barrows.json::name": "Barrows",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/barrows.json::pages/0/title": "Barrows",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/barrows.json::pages/0/text": "Từng là nơi chôn cất người chết, những địa điểm này đã hoang phế theo năm tháng. Không ai biết kho báu — hay người chết — có còn ở đó hay không.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/barrows.json::pages/1/title": "A Barrow",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/barrows.json::pages/1/text": "Một nơi để khám phá.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/huts.json::name": "Huts",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/huts.json::pages/0/title": "Huts",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/huts.json::pages/0/text": "Bạn có thể bắt gặp Huts trên khắp thế giới, đặc biệt trong các quần xã bằng phẳng hoặc kiểu đồng bằng. Chúng là căn cứ khởi đầu khá ổn, và biết đâu bạn còn tìm thấy thứ gì đó thú vị dưới hầm!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/huts.json::pages/1/title": "Huts nơi hoang dã!",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/locations/huts.json::pages/1/text": "Một nơi lý tưởng để gọi là nhà.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/amethyst.json::name": "Amethyst",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/amethyst.json::pages/0/text": "Có thể phá Amethyst ore để lấy Amethyst gems. Loại quặng này hiếm ngang Diamond và có công dụng tương tự.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/amethyst.json::pages/1/title": "Amethyst Gems",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/amethyst.json::pages/1/text": "Công cụ và vũ khí Amethyst có cấp khai thác ngang công cụ Diamond cùng độ bền tương đương.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/amethyst.json::pages/2/title": "Amethyst Tools",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/copper.json::name": "Copper",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/copper.json::pages/0/text": "Copper Ore xuất hiện phổ biến khắp thế giới ở nhiều độ cao khác nhau. Có thể nung quặng thành Copper Ingot để chế tạo công cụ.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/copper.json::pages/1/title": "Copper Ingots",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/copper.json::pages/1/text": "Công cụ và vũ khí bằng Copper có cấp khai thác tương đương sắt.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/copper.json::pages/2/title": "Copper Tools",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/quartz.json::name": "Quartz Ore",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/quartz.json::pages/0/text": "Quartz xuất hiện trong các cụm Granite ở Overworld và khi khai thác sẽ cho kết quả giống Quartz tìm thấy ở Nether.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/silver.json::name": "Silver",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/silver.json::pages/0/text": "Silver Ore xuất hiện ở những khu vực và độ sâu tương tự Gold Ore. Có thể nung quặng thành Silver Ingot để chế tạo công cụ có khả năng phù phép gần tương đương vàng nhưng bền hơn.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/silver.json::pages/1/title": "Silver Ingots",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/silver.json::pages/1/text": "Công cụ và vũ khí bằng Silver có cấp khai thác tương đương công cụ bằng vàng.",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/ores/silver.json::pages/2/title": "Silver Tools",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/0/text": "#title",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/1/text": "#groupSize",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/2/text": "#breed",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/3/text": "#tame",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/4/text": "#biomes",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/5/text": "#blurb",
  "assets/mysticalworld/patchouli_books/world_guide/en_us/templates/animal_spawn_info.json::components/6/text": "Vật phẩm rơi ra"
}
