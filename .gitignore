# Build output — regenerated by tools/build_*.py
/build/

# Release artifacts — large zips, rebuilt from source + work/translated.
# The manifest, acceptance record and SHA256SUMS.txt ARE tracked: they are the
# evidence of what shipped. The zips themselves are reproducible output.
/release/**/*.zip
/release/**/test*.txt
/release/**/verify_output.txt

# Backups — snapshots of work/translated taken before risky writes.
# The git history replaces these; they are not worth 150 MB of repo.
/work/backups/
/work/backup_*/
/work/server-overlay-backups/
/work/client-overlay-backups/
/work/quark-config-backups/
/work/*.zip

# Hermes session transcripts and agent scratch — not project source
/session-backups/
/.hermes/
/.omx/
/.playwright-mcp/
/.pytest_cache/
__pycache__/
*.pyc

# Large generated audit dumps — reproducible from tools/, and noisy in diffs
/work/elyprism-locale-gap-candidates.json
/work/elyprism-effective-ui-gaps.json
/work/session-home-dj2-hits.json
/work/identical_english_audit.json

# Poster art is a rebuildable ~1MB binary; font PNGs stay as release evidence
release/**/*Poster*.png

# Credentials — never tracked. RCON password lives here.
/work/secrets/

# server.properties snapshots taken before edits (contain rcon password)
/work/server-properties-backups/
